@using DotNetStarterProject.Helpers
@model DotNetStarterProject.Models.DangerSpot
@{
    ViewData["Title"] = "危険地点詳細";
}

<div class="container py-5">
    <!-- Back Button -->
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center text-muted transition-all hover-primary">
            <i class="bi bi-arrow-left me-2 fs-5"></i>
            <span class="fw-bold">一覧に戻る</span>
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg overflow-hidden rounded-4">
                <!-- Hero Image Section -->
                <div class="position-relative" style="height: 450px;">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" class="w-100 h-100 object-fit-cover" alt="@Model.Title">
                    }
                    else
                    {
                        <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center flex-column text-muted">
                            <i class="bi bi-image fs-1 mb-2"></i>
                            <span class="fw-bold">画像が登録されていません</span>
                        </div>
                    }
                    <div class="position-absolute bottom-0 start-0 w-100 p-4 p-md-5" style="background: linear-gradient(transparent, rgba(0,0,0,0.8));">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="badge bg-@DangerLevelHelper.GetBootstrapClass(Model.Level) px-3 py-2 rounded-pill fw-bold shadow-sm">
                                判定: @DangerLevelHelper.GetDangerLevel(Model.Level)
                            </span>
                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-bold shadow-sm">
                                報告: @Model.ReportCount 件
                            </span>
                            <span class="badge @(Model.Status == DangerSpotStatus.Resolved ? "bg-success" : (Model.Status == DangerSpotStatus.Confirmed ? "bg-warning" : "bg-secondary")) px-3 py-2 rounded-pill fw-bold shadow-sm">
                                状態: @Model.Status
                            </span>
                        </div>
                        <h1 class="text-white fw-black display-5 m-0 text-shadow">@Model.Title</h1>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row g-5">
                        <!-- Main Info Column -->
                        <div class="col-md-7">
                            
                            @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId)
                            {
                                <section class="mb-5 bg-light p-4 rounded-4">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-arrow-repeat me-2"></i> 状態の変更</h6>
                                    <div class="d-flex gap-2">
                                        <form asp-action="ChangeStatus" method="post">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="status" value="@DangerSpotStatus.Open" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill @(Model.Status == DangerSpotStatus.Open ? "active" : "")">未確認</button>
                                        </form>
                                        <form asp-action="ChangeStatus" method="post">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="status" value="@DangerSpotStatus.Confirmed" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill @(Model.Status == DangerSpotStatus.Confirmed ? "active" : "")">確認済</button>
                                        </form>
                                        <form asp-action="ChangeStatus" method="post">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="status" value="@DangerSpotStatus.Resolved" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill @(Model.Status == DangerSpotStatus.Resolved ? "active" : "")">解決済</button>
                                        </form>
                                    </div>
                                </section>
                            }
                            <section class="mb-5">
                                <h5 class="fw-bold mb-4 d-flex align-items-center">
                                    <i class="bi bi-info-circle-fill text-primary me-2"></i> 危険の詳細
                                </h5>
                                <p class="text-muted lh-lg fs-5">@Model.Description</p>
                            </section>

                            <section>
                                <h5 class="fw-bold mb-4 d-flex align-items-center">
                                    <i class="bi bi-grid-fill text-primary me-2"></i> 基本情報
                                </h5>
                                <div class="list-group list-group-flush rounded-3 border">
                                    <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                        <span class="text-muted fw-bold small text-uppercase">カテゴリ</span>
                                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                                            @foreach (var category in Model.Category.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                var (tagClass, displayName, icon) = category.Trim() switch
                                                {
                                                    "Crossing" => ("text-danger bg-danger-soft", "横断困難", "bi-signpost-2"),
                                                    "NoSidewalk" => ("text-warning bg-warning-soft", "歩道未整備", "bi-hammer"),
                                                    "HeavyTraffic" => ("text-warning bg-warning-soft", "バイク交通量過多", "bi-bicycle"),
                                                    "Flood" => ("text-info bg-info-soft", "冠水エリア", "bi-water"),
                                                    "NightRisk" => ("text-secondary bg-secondary-soft", "夜間危険", "bi-moon-stars"),
                                                    "Construction" => ("text-primary bg-primary-soft", "工事中", "bi-cone-striped"),
                                                    "NoSignal" => ("text-primary bg-primary-soft", "信号機なし", "bi-traffic-light"),
                                                    _ => ("text-primary bg-primary-soft", category, "bi-geo-alt")
                                                };

                                                <span class="category-tag px-3 py-1 rounded-pill @tagClass">
                                                    <i class="bi @icon me-1"></i> @displayName
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                        <span class="text-muted fw-bold small text-uppercase">登録日時</span>
                                        <span class="fw-medium text-dark">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                        <span class="text-muted fw-bold small text-uppercase">投稿者</span>
                                        <span class="fw-medium text-dark d-flex align-items-center">
                                            <i class="bi bi-person-circle me-2 text-primary"></i>
                                            @(Model.User?.UserName ?? "不明")
                                        </span>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <!-- Sidebar Column -->
                        <div class="col-md-5">
                            <section class="mb-5">
                                <h5 class="fw-bold mb-4 d-flex align-items-center">
                                    <i class="bi bi-geo-alt-fill text-danger me-2"></i> 位置情報
                                </h5>
                                <div class="card border shadow-sm rounded-4 overflow-hidden mb-3">
                                    <div id="map" style="height: 250px;"></div>
                                    <div class="p-3 bg-light border-top">
                                        <p class="small text-muted mb-0"><i class="bi bi-pin-map-fill text-danger me-1"></i> 緯度: @Model.Latitude, 経度: @Model.Longitude</p>
                                    </div>
                                </div>
                                <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-outline-dark w-100 py-3 rounded-pill fw-bold transition-all shadow-sm">
                                    <i class="bi bi-box-arrow-up-right me-2"></i> Google Mapsで開く
                                </a>
                            </section>

                            @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId)
                            {
                                <section>
                                    <h5 class="fw-bold mb-4 d-flex align-items-center">
                                        <i class="bi bi-gear-wide-connected text-secondary me-2"></i> 管理操作
                                    </h5>
                                    <div class="d-grid gap-3">
                                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary py-3 rounded-pill fw-bold shadow-sm">
                                            <i class="bi bi-pencil-square me-2"></i> 投稿を編集する
                                        </a>
                                        <button type="button" class="btn btn-outline-danger py-3 rounded-pill fw-bold shadow-sm" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteModal"
                                                data-id="@Model.Id"
                                                data-title="@Model.Title">
                                            <i class="bi bi-trash3-fill me-2"></i> 投稿を削除する
                                        </button>
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">削除の確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0 text-muted">「<span id="deleteItemTitle" class="fw-bold text-dark"></span>」を削除してもよろしいですか？この操作は取り消せません。</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4 fw-bold" data-bs-dismiss="modal">キャンセル</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="deleteItemId" value="" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">削除する</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function initMap() {
            const lat = parseFloat(@Model.Latitude);
            const lng = parseFloat(@Model.Longitude);
            
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 15,
                center: { lat: lat, lng: lng }
            });
            
            new google.maps.Marker({
                position: { lat: lat, lng: lng },
                map: map,
                title: "@Model.Title"
            });
        }
        window.initMap = initMap;

        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const title = button.getAttribute('data-title');
                
                document.getElementById('deleteItemId').value = id;
                document.getElementById('deleteItemTitle').textContent = title;
            });
        }
    </script>
}

<style>
    .fw-black { font-weight: 900; }
    .text-shadow { text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
    .transition-all { transition: all 0.3s ease; }
    .hover-primary:hover { color: var(--bs-primary) !important; transform: translateX(-5px); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    .bg-secondary-soft { background-color: rgba(108, 117, 125, 0.1); }
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .category-tag { border: 1px solid transparent; font-size: 0.85rem; font-weight: 700; }
</style>
