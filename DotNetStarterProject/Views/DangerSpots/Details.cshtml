@{
    ViewData["Title"] = "危険地点詳細";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small text-muted">
            <i class="bi bi-arrow-left me-1"></i> 一覧に戻る
        </a>
    </div>

    <div class="row g-4">
        <!-- Left Column: Info -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <h1 class="fw-bold h2 m-0">横断が非常に困難</h1>
                        <span class="badge bg-danger px-3 py-2 fw-bold">非常に危険</span>
                    </div>

                    <div class="mb-5">
                        <div class="row border-bottom py-3">
                            <div class="col-sm-4 fw-bold text-muted small text-uppercase">カテゴリ</div>
                            <div class="col-sm-8"><span class="category-tag text-danger border-danger">横断困難</span></div>
                        </div>
                        <div class="row border-bottom py-3">
                            <div class="col-sm-4 fw-bold text-muted small text-uppercase">危険レベル</div>
                            <div class="col-sm-8 d-flex align-items-center">
                                <span class="badge-danger-level badge-5 me-2">5</span>
                                <span class="fw-bold text-danger">(非常に危険)</span>
                            </div>
                        </div>
                        <div class="row border-bottom py-3">
                            <div class="col-sm-4 fw-bold text-muted small text-uppercase">説明</div>
                            <div class="col-sm-8 text-muted">信号がなく、車のスピードも速いため、横断するのが非常に困難です。特に夕方は車が多く注意が必要です。</div>
                        </div>
                        <div class="row border-bottom py-3">
                            <div class="col-sm-4 fw-bold text-muted small text-uppercase">場所</div>
                            <div class="col-sm-8 text-muted">ホーチミン市 1区 Nguyen Hue 通り付近</div>
                        </div>
                        <div class="row border-bottom py-3">
                            <div class="col-sm-4 fw-bold text-muted small text-uppercase">登録日時</div>
                            <div class="col-sm-8 text-muted">2024/05/20 14:30</div>
                        </div>
                        <div class="row border-bottom py-3">
                            <div class="col-sm-4 fw-bold text-muted small text-uppercase">投稿者</div>
                            <div class="col-sm-8 text-muted">Tanaka</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary px-4 fw-bold">編集</button>
                        <button class="btn btn-outline-danger px-4 fw-bold">削除</button>
                        <a asp-action="Index" class="btn btn-dark px-4 fw-bold ms-auto">一覧に戻る</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Media -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0 overflow-hidden rounded">
                    <img src="https://images.unsplash.com/photo-1544006659-f0b21f04cb1d?q=80&w=2070&auto=format&fit=crop" class="img-fluid w-100" alt="Spot Image">
                    <div class="p-2 d-flex gap-2 bg-light">
                        <img src="https://images.unsplash.com/photo-1544006659-f0b21f04cb1d?q=80&w=2070&auto=format&fit=crop" class="img-thumbnail" style="width: 80px; height: 60px; object-fit: cover;">
                        <img src="https://images.unsplash.com/photo-1526232759583-26f173b4042c?q=80&w=2070&auto=format&fit=crop" class="img-thumbnail" style="width: 80px; height: 60px; object-fit: cover;">
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm overflow-hidden" style="height: 300px;">
                <div class="h-100 d-flex align-items-center justify-content-center bg-light text-muted flex-column">
                    <i class="bi bi-map-fill fs-1 mb-2"></i>
                    <span class="small fw-bold">マッププレビュー</span>
                    <img src="https://api.placeholder.com/400/300?text=Map+Location" class="img-fluid position-absolute w-100 h-100" style="object-fit: cover; opacity: 0.5;" alt="Map">
                </div>
            </div>
        </div>
    </div>
</div>
