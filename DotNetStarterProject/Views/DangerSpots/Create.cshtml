@{
    ViewData["Title"] = "新規投稿";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom p-4">
                    <h1 class="fw-bold h3 m-0">新規投稿</h1>
                </div>
                <div class="card-body p-4">
                    <form>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">タイトル</label>
                            <input type="text" class="form-control border-0 bg-light p-3" placeholder="タイトルを入力">
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">カテゴリ</label>
                                <select class="form-select border-0 bg-light p-3">
                                    <option value="">カテゴリを選択</option>
                                    <option>横断困難</option>
                                    <option>歩道未整備</option>
                                    <option>バイク交通量過多</option>
                                    <option>冠水エリア</option>
                                    <option>夜間危険</option>
                                    <option>工事中</option>
                                    <option>信号機なし</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">危険レベル</label>
                                <select class="form-select border-0 bg-light p-3">
                                    <option value="">危険レベルを選択</option>
                                    <option value="1">1 (軽微)</option>
                                    <option value="2">2 (注意)</option>
                                    <option value="3">3 (危険)</option>
                                    <option value="4">4 (非常に危険)</option>
                                    <option value="5">5 (回避推奨)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">説明</label>
                            <textarea class="form-control border-0 bg-light p-3" rows="4" placeholder="危険内容の詳細を入力してください"></textarea>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-5">
                                <label class="form-label fw-bold small text-muted">緯度</label>
                                <input type="text" class="form-control border-0 bg-light p-3" placeholder="例) 10.7769">
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold small text-muted">経度</label>
                                <input type="text" class="form-control border-0 bg-light p-3" placeholder="例) 106.7009">
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-outline-primary w-100 p-3" title="現在地を取得">
                                    <i class="bi bi-geo-alt"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold small text-muted">画像</label>
                            <input type="file" class="form-control border-0 bg-light p-3">
                            <div class="form-text small">危険な場所の状況がわかる画像をアップロードしてください。</div>
                        </div>

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-light px-4 py-3 fw-bold">キャンセル</a>
                            <button type="submit" class="btn btn-primary px-5 py-3 fw-bold shadow-sm">投稿する</button>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Map Placeholder -->
            <div class="mt-4">
                <div class="card border-0 shadow-sm overflow-hidden" style="height: 300px;">
                    <div class="h-100 d-flex align-items-center justify-content-center bg-light text-muted flex-column">
                        <i class="bi bi-map fs-1 mb-2"></i>
                        <span>マップから場所を選択 (開発中)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
