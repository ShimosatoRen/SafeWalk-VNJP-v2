@model IEnumerable<DotNetStarterProject.Models.DangerSpot>
@{
    ViewData["Title"] = "危険地点一覧";
    var currentCategory = ViewData["CurrentCategory"] as string;
    var currentDangerLevel = ViewData["CurrentDangerLevel"] as int?;
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold h2 m-0">危険地点一覧</h1>
        <a asp-action="Create" class="btn btn-primary px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> 新規投稿
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">カテゴリ</label>
                    <select name="category" class="form-select border-0 bg-light">
                        <option value="">すべて</option>
                        <option selected="@(currentCategory == "横断困難")">横断困難</option>
                        <option selected="@(currentCategory == "歩道未整備")">歩道未整備</option>
                        <option selected="@(currentCategory == "バイク交通量過多")">バイク交通量過多</option>
                        <option selected="@(currentCategory == "冠水エリア")">冠水エリア</option>
                        <option selected="@(currentCategory == "夜間危険")">夜間危険</option>
                        <option selected="@(currentCategory == "工事中")">工事中</option>
                        <option selected="@(currentCategory == "信号機なし")">信号機なし</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">危険レベル</label>
                    <select name="dangerLevel" class="form-select border-0 bg-light">
                        <option value="">すべて</option>
                        <option value="1" selected="@(currentDangerLevel == 1)">1 (軽微)</option>
                        <option value="2" selected="@(currentDangerLevel == 2)">2 (注意)</option>
                        <option value="3" selected="@(currentDangerLevel == 3)">3 (危険)</option>
                        <option value="4" selected="@(currentDangerLevel == 4)">4 (非常に危険)</option>
                        <option value="5" selected="@(currentDangerLevel == 5)">5 (回避推奨)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">キーワード検索</label>
                    <input type="text" name="searchString" class="form-control border-0 bg-light" placeholder="キーワードを入力" value="@currentFilter">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100 fw-bold">
                        <i class="bi bi-search me-1"></i> 検索
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 border-0 py-3 text-muted small text-uppercase fw-bold" style="width: 80px;">ID</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold">タイトル</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold">カテゴリ</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold text-center">危険レベル</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold">登録日時</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold text-end pe-4">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                登録された危険地点がありません。
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">@item.Id</td>
                            <td class="fw-bold">@item.Title</td>
                            <td>
                                @{
                                    var (tagClass, displayName) = item.Category switch
                                    {
                                        "Crossing" => ("text-danger border-danger", "横断困難"),
                                        "NoSidewalk" => ("text-warning border-warning", "歩道未整備"),
                                        "HeavyTraffic" => ("text-warning border-warning", "バイク交通量過多"),
                                        "Flood" => ("text-info border-info", "冠水エリア"),
                                        "NightRisk" => ("text-secondary border-secondary", "夜間危険"),
                                        "Construction" => ("text-primary border-primary", "工事中"),
                                        "NoSignal" => ("text-primary border-primary", "信号機なし"),
                                        _ => ("text-primary border-primary", item.Category)
                                    };
                                }
                                <span class="category-tag @tagClass">@displayName</span>
                            </td>
                            <td class="text-center">
                                <span class="badge-danger-level badge-@item.DangerLevel">@item.DangerLevel</span>
                            </td>
                            <td class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-start-pill px-3">詳細</a>
                                    @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == item.UserId)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning px-3">編集</a>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-end-pill px-3" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Id" data-title="@item.Title">
                                            削除
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">削除の確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0 text-muted">「<span id="deleteItemTitle" class="fw-bold text-dark"></span>」を削除してもよろしいですか？この操作は取り消せません。</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4 fw-bold" data-bs-dismiss="modal">キャンセル</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="deleteItemId" value="" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">削除する</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const title = button.getAttribute('data-title');
                
                document.getElementById('deleteItemId').value = id;
                document.getElementById('deleteItemTitle').textContent = title;
            });
        }
    </script>
}
