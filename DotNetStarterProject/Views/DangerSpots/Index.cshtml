@{
    ViewData["Title"] = "危険地点一覧";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold h2 m-0">危険地点一覧</h1>
        <a asp-action="Create" class="btn btn-primary px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> 新規投稿
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">カテゴリ</label>
                    <select class="form-select border-0 bg-light">
                        <option value="">すべて</option>
                        <option>横断困難</option>
                        <option>歩道未整備</option>
                        <option>バイク交通量過多</option>
                        <option>冠水エリア</option>
                        <option>夜間危険</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">危険レベル</label>
                    <select class="form-select border-0 bg-light">
                        <option value="">すべて</option>
                        <option value="1">1 (軽微)</option>
                        <option value="2">2 (注意)</option>
                        <option value="3">3 (危険)</option>
                        <option value="4">4 (非常に危険)</option>
                        <option value="5">5 (回避推奨)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">キーワード検索</label>
                    <input type="text" class="form-control border-0 bg-light" placeholder="キーワードを入力">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100 fw-bold">
                        <i class="bi bi-search me-1"></i> 検索
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 border-0 py-3 text-muted small text-uppercase fw-bold" style="width: 80px;">ID</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold">タイトル</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold">カテゴリ</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold text-center">危険レベル</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold">登録日時</th>
                        <th class="border-0 py-3 text-muted small text-uppercase fw-bold text-end pe-4">操作</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Mock Data Row 1 -->
                    <tr>
                        <td class="ps-4 fw-bold text-muted">103</td>
                        <td class="fw-bold">横断が非常に困難</td>
                        <td><span class="category-tag text-danger border-danger">横断困難</span></td>
                        <td class="text-center">
                            <span class="badge-danger-level badge-5">5</span>
                        </td>
                        <td class="small text-muted">2024/05/20 14:30</td>
                        <td class="text-end pe-4">
                            <a href="#" class="btn btn-sm btn-outline-primary rounded-pill px-3">詳細</a>
                        </td>
                    </tr>
                    <!-- Mock Data Row 2 -->
                    <tr>
                        <td class="ps-4 fw-bold text-muted">102</td>
                        <td class="fw-bold">歩道が途切れている</td>
                        <td><span class="category-tag text-warning border-warning">歩道未整備</span></td>
                        <td class="text-center">
                            <span class="badge-danger-level badge-4">4</span>
                        </td>
                        <td class="small text-muted">2024/05/19 10:15</td>
                        <td class="text-end pe-4">
                            <a href="#" class="btn btn-sm btn-outline-primary rounded-pill px-3">詳細</a>
                        </td>
                    </tr>
                    <!-- Mock Data Row 3 -->
                    <tr>
                        <td class="ps-4 fw-bold text-muted">101</td>
                        <td class="fw-bold">バイクの交通量が多い交差点</td>
                        <td><span class="category-tag text-warning border-warning">バイク交通量過多</span></td>
                        <td class="text-center">
                            <span class="badge-danger-level badge-4">4</span>
                        </td>
                        <td class="small text-muted">2024/05/18 18:45</td>
                        <td class="text-end pe-4">
                            <a href="#" class="btn btn-sm btn-outline-primary rounded-pill px-3">詳細</a>
                        </td>
                    </tr>
                    <!-- Mock Data Row 4 -->
                    <tr>
                        <td class="ps-4 fw-bold text-muted">100</td>
                        <td class="fw-bold">冠水しやすいエリア</td>
                        <td><span class="category-tag text-info border-info">冠水エリア</span></td>
                        <td class="text-center">
                            <span class="badge-danger-level badge-3">3</span>
                        </td>
                        <td class="small text-muted">2024/05/18 09:20</td>
                        <td class="text-end pe-4">
                            <a href="#" class="btn btn-sm btn-outline-primary rounded-pill px-3">詳細</a>
                        </td>
                    </tr>
                    <!-- Mock Data Row 5 -->
                    <tr>
                        <td class="ps-4 fw-bold text-muted">99</td>
                        <td class="fw-bold">夜間は暗くて危険</td>
                        <td><span class="category-tag text-secondary border-secondary">夜間危険</span></td>
                        <td class="text-center">
                            <span class="badge-danger-level badge-3">3</span>
                        </td>
                        <td class="small text-muted">2024/05/17 21:10</td>
                        <td class="text-end pe-4">
                            <a href="#" class="btn btn-sm btn-outline-primary rounded-pill px-3">詳細</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
