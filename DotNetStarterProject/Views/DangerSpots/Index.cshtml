@using DotNetStarterProject.Helpers
@model IEnumerable<DotNetStarterProject.Models.DangerSpot>
@{
    ViewData["Title"] = "危険地点一覧";
// ... (omitting current vars for brevity in planning, but tool requires exact context)
    var currentCategory = ViewData["CurrentCategory"] as string;
    var currentDangerLevel = ViewData["CurrentDangerLevel"] as int?;
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold h2 m-0">危険地点一覧</h1>
        <a asp-action="Create" class="btn btn-primary px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> 新規投稿
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">カテゴリ</label>
                    <select name="category" class="form-select border-0 bg-light">
                        <option value="">すべて</option>
                        <option selected="@(currentCategory == "横断困難")">横断困難</option>
                        <option selected="@(currentCategory == "歩道未整備")">歩道未整備</option>
                        <option selected="@(currentCategory == "バイク交通量過多")">バイク交通量過多</option>
                        <option selected="@(currentCategory == "冠水エリア")">冠水エリア</option>
                        <option selected="@(currentCategory == "夜間危険")">夜間危険</option>
                        <option selected="@(currentCategory == "工事中")">工事中</option>
                        <option selected="@(currentCategory == "信号機なし")">信号機なし</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">危険レベル</label>
                    <select name="dangerLevel" class="form-select border-0 bg-light">
                        <option value="">すべて</option>
                        <option value="1" selected="@(currentDangerLevel == 1)">1 (軽微)</option>
                        <option value="2" selected="@(currentDangerLevel == 2)">2 (注意)</option>
                        <option value="3" selected="@(currentDangerLevel == 3)">3 (危険)</option>
                        <option value="4" selected="@(currentDangerLevel == 4)">4 (非常に危険)</option>
                        <option value="5" selected="@(currentDangerLevel == 5)">5 (回避推奨)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">キーワード検索</label>
                    <input type="text" name="searchString" class="form-control border-0 bg-light" placeholder="キーワードを入力" value="@currentFilter">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100 fw-bold">
                        <i class="bi bi-search me-1"></i> 検索
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Cards -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm py-5 text-center">
                    <div class="card-body">
                        <i class="bi bi-geo-fill display-1 text-light mb-4"></i>
                        <h4 class="text-muted">登録された危険地点がありません。</h4>
                        <p class="text-muted mb-4">あなたの周りの危険な場所を最初の投稿として登録しましょう！</p>
                        <a asp-action="Create" class="btn btn-primary px-4 fw-bold shadow-sm">
                            <i class="bi bi-plus-lg me-1"></i> 新規投稿する
                        </a>
                    </div>
                </div>
            </div>
        }
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-all hover-lift">
                    <div class="position-relative" style="height: 200px;">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" class="w-100 h-100 object-fit-cover" alt="@item.Title">
                        }
                        else
                        {
                            <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted">
                                <i class="bi bi-image fs-1 opacity-25"></i>
                            </div>
                        }
                        <div class="position-absolute top-0 end-0 p-3 d-flex flex-column gap-2">
                            <span class="badge bg-@DangerLevelHelper.GetBootstrapClass(item.ReportCount) shadow-sm px-3 py-2 rounded-pill fw-bold">
                                @DangerLevelHelper.GetDangerLevel(item.ReportCount)
                            </span>
                            <span class="badge @(item.Status == DangerSpotStatus.Resolved ? "bg-success" : (item.Status == DangerSpotStatus.Confirmed ? "bg-warning" : "bg-secondary")) shadow-sm px-3 py-2 rounded-pill fw-bold">
                                @item.Status
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            @{
                                var (tagClass, displayName, icon) = item.Category switch
                                {
                                    "Crossing" => ("text-danger", "横断困難", "bi-signpost-2"),
                                    "NoSidewalk" => ("text-warning", "歩道未整備", "bi-hammer"),
                                    "HeavyTraffic" => ("text-warning", "バイク交通量過多", "bi-bicycle"),
                                    "Flood" => ("text-info", "冠水エリア", "bi-water"),
                                    "NightRisk" => ("text-secondary", "夜間危険", "bi-moon-stars"),
                                    "Construction" => ("text-primary", "工事中", "bi-cone-striped"),
                                    "NoSignal" => ("text-primary", "信号機なし", "bi-traffic-light"),
                                    _ => ("text-primary", item.Category, "bi-geo-alt")
                                };
                            }
                            <span class="category-tag @tagClass">
                                <i class="bi @icon"></i> @displayName
                            </span>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</small>
                        </div>
                        <h5 class="card-title fw-bold mb-3">@item.Title</h5>
                        <p class="card-text text-muted small mb-4 line-clamp-2">@item.Description</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person-circle text-primary me-2"></i>
                                <small class="fw-bold text-muted">@(item.User?.UserName ?? "ユーザー")</small>
                            </div>
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">詳細を見る</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">削除の確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0 text-muted">「<span id="deleteItemTitle" class="fw-bold text-dark"></span>」を削除してもよろしいですか？この操作は取り消せません。</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4 fw-bold" data-bs-dismiss="modal">キャンセル</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="deleteItemId" value="" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">削除する</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const title = button.getAttribute('data-title');
                
                document.getElementById('deleteItemId').value = id;
                document.getElementById('deleteItemTitle').textContent = title;
            });
        }
    </script>
}
