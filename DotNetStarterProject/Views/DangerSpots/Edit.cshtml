@model DotNetStarterProject.Models.DangerSpot
@{
    ViewData["Title"] = "投稿の編集";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 p-4 pb-0">
                    <h2 class="fw-bold h3 m-0">投稿を編集する</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="ImagePath" />

                        <div class="form-floating mb-3">
                            <input asp-for="Title" class="form-control border-0 bg-light" placeholder="タイトルを入力">
                            <label asp-for="Title" class="text-muted">タイトル</label>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        @{
                            var selectedCategories = Model.Category?
                                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                .Select(x => x.Trim())
                                .ToList()
                                ?? new List<string>();
                        }

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted">
                                カテゴリ（複数選択可）
                            </label>

                            <div class="row g-2">

                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedCategories"
                                               value="Crossing"
                                        @(selectedCategories.Contains("Crossing") ? "checked" : "")>

                                        <label class="form-check-label">
                                            横断困難
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedCategories"
                                               value="NoSidewalk"
                                        @(selectedCategories.Contains("NoSidewalk") ? "checked" : "")>

                                        <label class="form-check-label">
                                            歩道未整備
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedCategories"
                                               value="HeavyTraffic"
                                        @(selectedCategories.Contains("HeavyTraffic") ? "checked" : "")>

                                        <label class="form-check-label">
                                            バイク交通量過多
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedCategories"
                                               value="Flood"
                                        @(selectedCategories.Contains("Flood") ? "checked" : "")>

                                        <label class="form-check-label">
                                            冠水エリア
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedCategories"
                                               value="NightRisk"
                                        @(selectedCategories.Contains("NightRisk") ? "checked" : "")>

                                        <label class="form-check-label">
                                            夜間危険
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedCategories"
                                               value="Construction"
                                        @(selectedCategories.Contains("Construction") ? "checked" : "")>

                                        <label class="form-check-label">
                                            工事中
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedCategories"
                                               value="NoSignal"
                                        @(selectedCategories.Contains("NoSignal") ? "checked" : "")>

                                        <label class="form-check-label">
                                            信号機なし
                                        </label>
                                    </div>
                                </div>

                            </div>

                            <span asp-validation-for="Category"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Description" class="form-control border-0 bg-light" placeholder="詳細を入力" style="height: 120px"></textarea>
                            <label asp-for="Description" class="text-muted">詳細な状況</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Location Inputs -->
                        <h6 class="fw-bold mb-3 mt-4 text-muted"><i class="bi bi-geo-alt-fill me-2"></i> 位置情報</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <input id="pac-input" class="form-control border-0 bg-light p-3" type="text" placeholder="場所を検索...">
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="form-floating">
                                            <input asp-for="Latitude" class="form-control border-0 bg-light" placeholder="緯度">
                                            <label asp-for="Latitude" class="text-muted">緯度</label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-floating">
                                            <input asp-for="Longitude" class="form-control border-0 bg-light" placeholder="経度">
                                            <label asp-for="Longitude" class="text-muted">経度</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-grid mb-4">
                                    <button type="button" class="btn btn-outline-primary" id="getLocation">
                                        <i class="bi bi-crosshair me-1"></i> 現在地を取得
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div id="map" class="rounded-4 overflow-hidden shadow-sm" style="height: 250px;"></div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted mb-2">現場の写真</label>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <div class="mb-3">
                                    <p class="small text-muted mb-2">現在の画像:</p>
                                    <img src="@Model.ImagePath" alt="Current Image" class="img-thumbnail rounded-3" style="max-height: 150px;">
                                </div>
                            }
                            <div class="input-group">
                                <input type="file" name="imageFile" id="imageInput" class="form-control bg-light border-0 p-3" accept="image/*">
                            </div>
                            <div class="form-text small mt-1">新しい画像を選択すると現在の画像が上書きされます。</div>
                            
                            <!-- Image Preview Area -->
                            <div id="imagePreviewContainer" class="d-none mt-3">
                                <p class="small fw-bold text-muted mb-2">新しい画像のプレビュー:</p>
                                <div class="position-relative d-inline-block rounded-4 overflow-hidden border shadow-sm">
                                    <img id="imagePreview" src="#" alt="Preview" class="img-fluid" style="max-height: 200px;">
                                    <button type="button" id="removeImage" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle" title="画像を削除">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-5">
                            <a asp-action="Index" class="btn btn-light px-4 py-3 fw-bold rounded-pill">キャンセル</a>
                            <button type="submit" class="btn btn-primary px-5 py-3 fw-bold rounded-pill shadow">
                                <i class="bi bi-check-lg me-2"></i> 保存する
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let map;
        let marker;

        function initMap() {
            const initialLat = parseFloat(@Model.Latitude) || 35.6812;
            const initialLng = parseFloat(@Model.Longitude) || 139.7671;
            
            map = new google.maps.Map(document.getElementById("map"), {
                zoom: 15,
                center: { lat: initialLat, lng: initialLng }
            });

            marker = new google.maps.Marker({
                position: { lat: initialLat, lng: initialLng },
                map: map,
                draggable: true
            });

            // Autocomplete setup
            const input = document.getElementById("pac-input");
            const autocomplete = new google.maps.places.Autocomplete(input);
            autocomplete.bindTo("bounds", map);

            autocomplete.addListener("place_changed", () => {
                const place = autocomplete.getPlace();
                if (!place.geometry || !place.geometry.location) return;

                if (place.geometry.viewport) {
                    map.fitBounds(place.geometry.viewport);
                } else {
                    map.setCenter(place.geometry.location);
                    map.setZoom(17);
                }
                marker.setPosition(place.geometry.location);
                updateInputs(place.geometry.location.lat(), place.geometry.location.lng());
            });

            google.maps.event.addListener(marker, 'dragend', function(evt){
                updateInputs(evt.latLng.lat(), evt.latLng.lng());
            });

            map.addListener('click', function(e) {
                marker.setPosition(e.latLng);
                updateInputs(e.latLng.lat(), e.latLng.lng());
            });
        }
        window.initMap = initMap;

        function updateInputs(lat, lng) {
            document.querySelector('[name="Latitude"]').value = lat.toFixed(7);
            document.querySelector('[name="Longitude"]').value = lng.toFixed(7);
        }

        // Geolocation logic
        document.getElementById('getLocation').addEventListener('click', function() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    marker.setPosition({ lat: lat, lng: lng });
                    map.setCenter({ lat: lat, lng: lng });
                    updateInputs(lat, lng);
                }, function(error) {
                    alert('位置情報の取得に失敗しました: ' + error.message);
                });
            } else {
                alert('お使いのブラウザは位置情報の取得に対応していません。');
            }
        });

        // Image preview logic
        const imageInput = document.getElementById('imageInput');
        const imagePreview = document.getElementById('imagePreview');
        const previewContainer = document.getElementById('imagePreviewContainer');
        const removeButton = document.getElementById('removeImage');

        imageInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    previewContainer.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            } else {
                previewContainer.classList.add('d-none');
            }
        });

        removeButton.addEventListener('click', function() {
            imageInput.value = '';
            previewContainer.classList.add('d-none');
            imagePreview.src = '#';
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
