@model IEnumerable<DotNetStarterProject.Models.DangerSpot>
@{
    ViewData["Title"] = "ホーム";
}

<div class="hero-container">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 text-center text-lg-start">
                <h1 class="hero-title">SafeWalk VNJP</h1>
                <h2 class="hero-subtitle mb-4">歩行者の安全のために、<br>危険情報を共有しよう</h2>
                <p class="lead mb-5">あなたの投稿が、誰かの命を守ります。</p>
                <div class="d-flex justify-content-center justify-content-lg-start gap-3 flex-wrap">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="DangerSpots" asp-action="Create" class="btn btn-primary btn-lg px-5 py-3 shadow-sm">
                            <i class="bi bi-plus-lg me-1"></i> 新規投稿
                        </a>
                        <a asp-controller="DangerSpots" asp-action="Map" class="btn btn-outline-primary btn-lg px-5 py-3 shadow-sm bg-white">
                            <i class="bi bi-map me-1"></i> マップ表示
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3 shadow-sm">ログイン</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg px-5 py-3 shadow-sm border">新規登録</a>
                    }
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="position-relative">
                    <!-- Mobile Mockup Wrapper -->
                    <div class="bg-dark rounded-4 p-2 shadow-lg mx-auto" style="width: 280px; height: 580px; border: 8px solid #333;">
                        <div class="bg-white h-100 rounded-3 overflow-hidden position-relative">
                            <div class="bg-primary p-3 text-white">
                                <small>8:45</small>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="fw-bold">SafeWalk VNJP</span>
                                    <i class="bi bi-list"></i>
                                </div>
                            </div>
                            <div class="p-4 text-center">
                                <h5 class="fw-bold mt-4">歩行者の安全のために、危険情報を共有しよう</h5>
                                <p class="small text-muted mt-3">あなたの投稿が、誰かの命を守ります。</p>
                                <div class="d-grid gap-2 mt-5">
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">ログイン</a>
                                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-sm">新規登録</a>
                                </div>
                                <div class="mt-5 text-start">
                                    <h6 class="fw-bold small">最近の危険地点</h6>
                                    @if (Model.Any())
                                    {
                                        var latest = Model.OrderByDescending(d => d.CreatedAt).First();
                                        <div class="bg-light p-2 rounded small mb-2 text-start">
                                            <div class="fw-bold text-truncate">@latest.Title</div>
                                            <span class="badge bg-danger p-1" style="font-size: 0.6rem;">@latest.Category</span>
                                        </div>
                                    }
                                    <img src="~/images/hero.jpg"
                                         class="img-fluid rounded border"
                                         alt="危険地点">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Map Section -->
    <div class="mb-5">
        <h3 class="fw-bold mb-4 d-flex align-items-center">
            <i class="bi bi-map-fill text-primary me-2"></i> 危険地点マップ
        </h3>
        <div class="card border-0 shadow-sm overflow-hidden rounded-4">
            <div id="homeMap" style="height: 500px;"></div>
            <div class="card-footer bg-white p-3 border-0">
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <span class="small text-muted"><i class="bi bi-circle-fill text-danger me-1"></i> 横断困難</span>
                    <span class="small text-muted"><i class="bi bi-circle-fill text-warning me-1"></i> 歩道未整備</span>
                    <span class="small text-muted"><i class="bi bi-circle-fill text-info me-1"></i> 冠水エリア</span>
                    <span class="small text-muted"><i class="bi bi-circle-fill text-primary me-1"></i> その他</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Purpose -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3 text-primary">
                            <i class="bi bi-shield-check fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold m-0">このアプリの目的</h5>
                    </div>
                    <p class="text-muted">歩行者が安全に移動できるように、危険な場所の情報を共有することで、事故やトラブルを未然に防ぎます。</p>
                </div>
            </div>
        </div>
        <!-- Usage -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3 text-primary">
                            <i class="bi bi-person-walking fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold m-0">使い方</h5>
                    </div>
                    <ol class="text-muted ps-3">
                        <li class="mb-2">危険な場所を見つけたら投稿</li>
                        <li class="mb-2">他の人の投稿を確認して注意</li>
                        <li class="mb-2">安全な街づくりに貢献しよう</li>
                    </ol>
                </div>
            </div>
        </div>
        <!-- Quick Stats or Info -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm bg-primary text-white rounded-4">
                <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                    <h4 class="fw-bold mb-3">安全な街を一緒に</h4>
                    <p class="mb-4">今すぐ参加して、あなたの周りの危険な場所を共有しましょう。</p>
                    <a asp-controller="DangerSpots" asp-action="Index" class="btn btn-light fw-bold rounded-pill px-4">危険地点一覧を見る</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <h5 class="fw-bold mb-4 border-start border-primary border-4 ps-3">危険レベル</h5>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="row text-center">
                        <div class="col">
                            <span class="badge-danger-level badge-1 mb-2"><i class="bi bi-info-lg"></i></span>
                            <div class="small fw-bold">軽微</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-2 mb-2"><i class="bi bi-exclamation-lg"></i></span>
                            <div class="small fw-bold">注意</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-3 mb-2"><i class="bi bi-signpost-split"></i></span>
                            <div class="small fw-bold">危険</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-4 mb-2"><i class="bi bi-exclamation-triangle-fill"></i></span>
                            <div class="small fw-bold">非常に危険</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-5 mb-2"><i class="bi bi-x-octagon-fill"></i></span>
                            <div class="small fw-bold">回避推奨</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <h5 class="fw-bold mb-4 border-start border-primary border-4 ps-3">カテゴリ</h5>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2">
                        <span class="category-tag"><i class="bi bi-signpost-2 me-1"></i> 横断困難</span>
                        <span class="category-tag"><i class="bi bi-hammer me-1"></i> 歩道未整備</span>
                        <span class="category-tag"><i class="bi bi-bicycle me-1"></i> バイク交通量過多</span>
                        <span class="category-tag"><i class="bi bi-water me-1"></i> 冠水エリア</span>
                        <span class="category-tag"><i class="bi bi-moon-stars me-1"></i> 夜間危険</span>
                        <span class="category-tag"><i class="bi bi-cone-striped me-1"></i> 工事中</span>
                        <span class="category-tag"><i class="bi bi-traffic-light me-1"></i> 信号機なし</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <script>
        // Initialize Map
        const map = L.map('homeMap').setView([10.7769, 106.7009], 13); // Default to HCMC or adjust as needed
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Add markers for all danger spots
        const spots = @Html.Raw(Json.Serialize(Model.Select(s => new { 
            s.Id, 
            s.Title, 
            s.Category, 
            s.Latitude, 
            s.Longitude,
            s.DangerLevel,
            DetailsUrl = Url.Action("Details", "DangerSpots", new { id = s.Id })
        })));

        if (spots.length > 0) {
            const markers = [];
            spots.forEach(spot => {
                let color = '#0d6efd'; // Default primary
                if (spot.category === 'Crossing') color = '#dc3545'; // Danger
                if (spot.category === 'NoSidewalk' || spot.category === 'HeavyTraffic') color = '#ffc107'; // Warning
                if (spot.category === 'Flood') color = '#0dcaf0'; // Info

                const marker = L.circleMarker([spot.latitude, spot.longitude], {
                    radius: 8,
                    fillColor: color,
                    color: "#fff",
                    weight: 2,
                    opacity: 1,
                    fillOpacity: 0.8
                }).addTo(map);

                marker.bindPopup(`
                    <div class="p-1">
                        <h6 class="fw-bold mb-1">${spot.title}</h6>
                        <p class="small text-muted mb-2">カテゴリ: ${spot.category}</p>
                        <a href="${spot.detailsUrl}" class="btn btn-primary btn-sm w-100 text-white">詳細を見る</a>
                    </div>
                `);
                markers.push([spot.latitude, spot.longitude]);
            });

            // Adjust map view to fit all markers
            if (markers.length > 0) {
                map.fitBounds(L.latLngBounds(markers), { padding: [50, 50] });
            }
        }
    </script>
}
