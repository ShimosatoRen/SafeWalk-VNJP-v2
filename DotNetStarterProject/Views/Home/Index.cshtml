@using DotNetStarterProject.Helpers
@using Microsoft.AspNetCore.Identity
@using DotNetStarterProject.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@model IEnumerable<DotNetStarterProject.Models.DangerSpot>
@{
    ViewData["Title"] = "ホーム";

    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var showAds = currentUser == null || !(currentUser.AdFreeUntil > DateTime.UtcNow);
}

<div class="hero-container">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 text-center text-lg-start">
                <h1 class="hero-title">SafeWalk VNJP</h1>
                <h2 class="hero-subtitle mb-4">歩行者の安全のために、<br>危険情報を共有しよう</h2>
                <p class="lead mb-5">あなたの投稿が、誰かの命を守ります。</p>
                <div class="d-flex justify-content-center justify-content-lg-start gap-3 flex-wrap">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="DangerSpots" asp-action="Create" class="btn btn-primary btn-lg px-5 py-3 shadow-sm">
                            <i class="bi bi-plus-lg me-1"></i> 新規投稿
                        </a>
                        <a asp-controller="DangerSpots" asp-action="Map" class="btn btn-outline-primary btn-lg px-5 py-3 shadow-sm bg-white">
                            <i class="bi bi-map me-1"></i> マップ表示
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> ログイン
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg px-5 py-3 shadow-sm border">
                            <i class="bi bi-person-plus-fill me-2"></i> 新規登録
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="position-relative">
                    <!-- Mobile Mockup Wrapper -->
                    <div class="bg-dark rounded-4 p-2 shadow-lg mx-auto" style="width: 280px; height: 580px; border: 8px solid #333;">
                        <div class="bg-white h-100 rounded-3 overflow-hidden position-relative">
                            <div class="bg-primary p-3 text-white">
                                <small id="mockup-clock">00:00</small>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none fw-bold" style="font-size: 0.9rem;">SafeWalk VNJP</a>
                                    <i class="bi bi-list" style="cursor: pointer;" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar" aria-controls="offcanvasSidebar" role="button"></i>
                                </div>
                            </div>
                            <div class="p-4 text-center">
                                <h5 class="fw-bold mt-4">歩行者の安全のために、危険情報を共有しよう</h5>
                                <p class="small text-muted mt-3">あなたの投稿が、誰かの命を守ります。</p>
                                <div class="d-grid gap-2 mt-5">
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> ログイン
                                    </a>
                                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-sm">
                                        <i class="bi bi-person-plus-fill me-1"></i> 新規登録
                                    </a>
                                </div>
                                <div class="mt-5 text-start">
                                    <h6 class="fw-bold small">最近の危険地点</h6>
                                    @if (Model.Any())
                                    {
                                        var latest = Model.OrderByDescending(d => d.CreatedAt).First();
                                        <div class="bg-light p-2 rounded small mb-2 text-start">
                                            <div class="fw-bold text-truncate">@latest.Title</div>
                                            <span class="badge bg-danger p-1" style="font-size: 0.6rem;">@latest.Category</span>
                                        </div>
                                    }
                                    <img src="~/images/hero.jpg"
                                         class="img-fluid rounded border"
                                         alt="危険地点">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (showAds)
{
    <!-- Ad Modal Popup -->
    <div class="modal fade" id="adModal" tabindex="-1" aria-labelledby="adModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold" id="adModalLabel">
                        <i class="bi bi-megaphone-fill me-2"></i> スポンサーからのお知らせ
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-gift fs-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-3">危険情報を投稿して特典をゲット！</h4>
                    <p class="text-muted">
                        SafeWalkでは、地域の安全情報を募集しています。<br>
                        新しい危険地点を投稿すると、<strong>24時間広告が非表示</strong>になります！
                    </p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <a asp-controller="DangerSpots" asp-action="Create" class="btn btn-primary px-4 rounded-pill">
                        今すぐ投稿する
                    </a>
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">閉じる</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="container mb-5">
    <div class="row g-4 mb-5">
        <!-- Purpose -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3 text-primary">
                            <i class="bi bi-shield-check fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold m-0">このアプリの目的</h5>
                    </div>
                    <p class="text-muted">歩行者が安全に移動できるように、危険な場所の情報を共有することで、事故やトラブルを未然に防ぎます。</p>
                </div>
            </div>
        </div>
        <!-- Usage -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3 text-primary">
                            <i class="bi bi-person-walking fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold m-0">使い方</h5>
                    </div>
                    <ol class="text-muted ps-3">
                        <li class="mb-2">危険な場所を見つけたら投稿</li>
                        <li class="mb-2">他の人の投稿を確認して注意</li>
                        <li class="mb-2">安全な街づくりに貢献しよう</li>
                    </ol>
                </div>
            </div>
        </div>
        <!-- Quick Stats or Info -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm bg-primary text-white rounded-4">
                <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                    <h4 class="fw-bold mb-3">安全な街を一緒に</h4>
                    <p class="mb-4">今すぐ参加して、あなたの周りの危険な場所を共有しましょう。</p>
                    <a asp-controller="DangerSpots" asp-action="Index" class="btn btn-light fw-bold rounded-pill px-4">危険地点一覧を見る</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <h5 class="fw-bold mb-4 border-start border-primary border-4 ps-3">危険レベル判定基準</h5>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="row text-center">
                        <div class="col">
                            <span class="badge-danger-level badge-1 mb-2" style="background-color: #007bff !important;"><i class="bi bi-info-lg"></i></span>
                            <div class="small fw-bold">軽微</div>
                            <div class="text-muted" style="font-size: 0.7rem;">0-1件</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-2 mb-2" style="background-color: #28a745 !important;"><i class="bi bi-exclamation-lg"></i></span>
                            <div class="small fw-bold">注意</div>
                            <div class="text-muted" style="font-size: 0.7rem;">2件</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-3 mb-2" style="background-color: #ffc107 !important;"><i class="bi bi-signpost-split"></i></span>
                            <div class="small fw-bold">危険</div>
                            <div class="text-muted" style="font-size: 0.7rem;">3-4件</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-4 mb-2" style="background-color: #fd7e14 !important;"><i class="bi bi-exclamation-triangle-fill"></i></span>
                            <div class="small fw-bold">非常に危険</div>
                            <div class="text-muted" style="font-size: 0.7rem;">5-6件</div>
                        </div>
                        <div class="col">
                            <span class="badge-danger-level badge-5 mb-2" style="background-color: #dc3545 !important;"><i class="bi bi-x-octagon-fill"></i></span>
                            <div class="small fw-bold">回避推奨</div>
                            <div class="text-muted" style="font-size: 0.7rem;">7件〜</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <h5 class="fw-bold mb-4 border-start border-primary border-4 ps-3">カテゴリ</h5>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2">
                        <span class="category-tag"><i class="bi bi-signpost-2 me-1"></i> 横断困難</span>
                        <span class="category-tag"><i class="bi bi-hammer me-1"></i> 歩道未整備</span>
                        <span class="category-tag"><i class="bi bi-bicycle me-1"></i> バイク交通量過多</span>
                        <span class="category-tag"><i class="bi bi-water me-1"></i> 冠水エリア</span>
                        <span class="category-tag"><i class="bi bi-moon-stars me-1"></i> 夜間危険</span>
                        <span class="category-tag"><i class="bi bi-cone-striped me-1"></i> 工事中</span>
                        <span class="category-tag"><i class="bi bi-traffic-light me-1"></i> 信号機なし</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (showAds)
    {
        <!-- Bottom Ad Section -->
        <div class="mt-5 pt-4 border-top">
            <div class="card border-0 shadow-sm bg-light rounded-4 overflow-hidden">
                <div class="row g-0 align-items-center">
                    <div class="col-md-8 p-4">
                        <h5 class="fw-bold text-dark mb-2">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i> スポンサー広告
                        </h5>
                        <p class="text-muted mb-0">
                            SafeWalk VNJPはスポンサーの支援によって運営されています。安全な街づくりにご協力をお願いします。
                            <br>
                            <span class="small">※危険地点を投稿すると、24時間この広告が非表示になります。</span>
                        </p>
                    </div>
                    <div class="col-md-4 p-4 text-center bg-white">
                        <a asp-controller="DangerSpots" asp-action="Create" class="btn btn-outline-primary fw-bold px-4">
                            情報を投稿して広告を消す
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Real-time clock for mobile mockup
        function updateMockupClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const clockEl = document.getElementById('mockup-clock');
            if (clockEl) {
                clockEl.textContent = `${hours}:${minutes}`;
            }
        }
        setInterval(updateMockupClock, 1000);
        updateMockupClock();

        @if (showAds)
        {
            <text>
            // Show ad modal on load
            document.addEventListener('DOMContentLoaded', function() {
                var modalEl = document.getElementById('adModal');
                if (modalEl) {
                    var myModal = new bootstrap.Modal(modalEl);
                    myModal.show();
                }
            });
            </text>
        }

        // Map removed from Home screen
        function initMap() {
            // No-op
        }
        window.initMap = initMap;
    </script>
}
